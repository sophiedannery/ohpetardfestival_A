{% extends 'base.html.twig' %}

{% block title %}Inscription Bloc Urbain - Oh Pétard Festival
{% endblock %}

{% block body %}


	<section class="bloc-hero text-center d-flex align-items-center justify-content-center">
		<div class="bloc-hero-content">
			<img src="{{ asset('assets/logos/Logo_JAUNE.png') }}" alt="Logo Oh Pétard" class="img-fluid mb-4" style="max-width: 200px;">

			<h1 class="fw-bold display-4 lineup-text">CONTEST BLOC URBAIN</h1>


		</div>
	</section>

	<section class="container inscription py-5">


		<section class="zones-texte bandeau-good-inscription py-3 text-center">
			<h3 class="m-0 lineup-big d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
				<span class="event">nouvel événement</span>
				<span class="etoile d-none d-md-inline">*</span>
				<span class="spot">nouveau spot</span>
				<span class="etoile d-none d-md-inline">*</span>
				<span class="sector">nouveaux secteurs urbains</span>
			</h3>
		</section>


		<div class="row g-4 align-items-start align-items-center justify-content-center mt-1 mt-md-5">

			<div class="col-md-6">
				<div class="info-box p-4 h-100">

					<div class="intro-text text-start mb-5 mx-auto">
						<p class="lead">Un contest de bloc, OUI. Mais un contest de bloc
							<strong>urbain</strong>, il fallait y penser ! 💪<br>
							Prends ton crashpad, tes chaussons, et viens découvrir Buis-les-Baronnies à la force de tes bras. Situé au pied du Mont Ventoux, le village accueille la toute première édition du
							<strong>Oh Pétard Festival</strong>
							!</p>
						<p>Pour toi, qui trouve le moindre coin à escalader, on t'a trouvé des blocs à différents coins de la ville.</p>

						<div class="text-start mt-5 mt-md-3">
							<p class="small-text">
								À partir de
								<strong>12 ans</strong>. Licence FFME ou CAF en cours
								<strong>ou</strong>
								certificat médical de non-contre-indication à l’escalade en compétition
								<strong>obligatoire</strong>.
							</p>
							<p class="text-small">
								<a href="{{ asset('assets/docs/REGLEMENT_CONTEST_AMICAL_BLOC_URBAIN_2025.pdf') }}" target="_blank" rel="noopener noreferrer">voir le réglement</a>
							</p>

						</div>
					</div>


				</div>
			</div>

			<div class="col-md-6 text-center">
				<div class="date-contest mb-4">
					<h4 class="m-0 lineup-text">
						samedi
						<span class="number ms-1">27</span>septembre
					</h4>
				</div>


				<div class="tarifs mb-4">
					<ul class="list-unstyled">
						<li>
							<strong>12€</strong>
							→ Contest + repas</li>
						<li>
							<strong>22€</strong>
							→ Contest + repas + concert</li>
					</ul>
				</div>

				<div class="my-5 my-md-0">
					<a href="https://www.helloasso.com/associations/association-oh-petard/boutiques/inscription-contest-bloc-urbain-oh-petard-festival" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
						Je m'inscris
					</a>
				</div>
			</div>

		</div>


		<section class="zones-texte bandeau-good-inscription py-3 text-center mt-5 mt-md-1">
			<h3 class="m-0 lineup-big d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
				<span class="spot">INFO CONTEST !</span>
			</h3>
		</section>


		<div class="row g-4 justify-content-center mt-1">

			<div class="col-12 col-md-10 col-lg-8 mx-auto">
				<img src="{{ asset('assets/plans/Plan_grimpe_urbaine_2025.jpg') }}" alt="Plan du parcours DH Urbaine 2025" class="img-fluid d-block mx-auto rounded shadow mb-4" loading="lazy">
			</div>

			<div class="col-12 col-md-8 mx-auto">
				<div class="info-box p-4 h-100 text-center">
					<p>
						Balade toi dans les rues de Buis-les-Baronnies à la recherche des 30 blocs qu'on a repéré pour l'occasion !  Un topo sera mis à ta disposition pour te guider dans les rues pittoresques du village !
					</p>
					<p>📸
						<strong>BONUS : Tu veux tenter de remporter des lots ?</strong>
						<br>Participe au concours photo pour mettre en avant la discipline et le patrimoine de Buis-les-Baronnies ! Prends tes potes en photo en train de grimper et à la fin de la journée, viens déposer ta photo préférée à l’accueil.
						<br><br>Rendez-vous à 19h pour le podium (place aux Herbes) pour découvrir si ta photo à été sélectionnée ✨</p>
					<p class="text-small">
						<a href="{{ asset('assets/docs/Plan_grimpe_urbaine_2025.pdf') }}" download>Télécharge le plan</a>
					</p>
				</div>
			</div>

		</div>


		<div
			class="row align-items-center mt-5">
			{# <h5 class="text-center mb-4 fw-bold">Nos partenaires escalade</h5> #}

			<div class="col d-flex justify-content-center gap-5 flex-wrap">
				<a href="https://www.outdoormixfestival.com/" target="_blank" rel="noopener noreferrer" class="me-4">
					<img src="{{ asset('assets/partenaires/partenaire_Outdoomix.png') }}" alt="Partenaire 4" class="img-fluid" style="max-height: 50px;">
				</a>
				<a href="https://ventouxbloc.com/" target="_blank" rel="noopener noreferrer" class="me-4">
					<img src="{{ asset('assets/partenaires/partenaire_Ventoux_Bloc.webp') }}" alt="Partenaire 4" class="img-fluid" style="max-height: 50px;">
				</a>
				<a href="https://nograd.fr/" target="_blank" rel="noopener noreferrer" class="me-4">
					<img src="{{ asset('assets/partenaires/partenaire_Nograd.png') }}" alt="Partenaire 4" class="img-fluid" style="max-height: 50px;">
				</a>
				<a href="https://brazz.it/fr/" target="_blank" rel="noopener noreferrer" class="me-4">
					<img src="{{ asset('assets/partenaires/partenaire_Brazz.jpg') }}" alt="Partenaire 4" class="img-fluid" style="max-height: 50px;">
				</a>
			</div>
		</div>


		<div class="text-center mt-5">
			<a href="{{ path('app_rider_registration')}}">
				<button class="btn btn-outline-primary">Retour</button>
			</a>
		</div>


	{% endblock %}
